{
  "rule_set": {
    "name": "NOTICE_OF_EXECUTION_AND_SECURITIES_SETTLEMENT_EXTRACT_RULES",
    "version": "1.0.0",
    "language": "vi",
    "strict_mode": true,
    "global_principles": {
      "no_inference_when_missing_text": true,
      "no_asset_type_guessing": true,
      "no_rule_switching_between_files": true,
      "prefer_source_text": true,
      "keep_defined_schema": true,
      "missing_value_policy": "NULL",
      "no_currency_conversion": true
    },
    "document_types": [
      "NOTICE_OF_EXECUTION",
      "SECURITIES_SETTLEMENT"
    ],
    "output_schema_fields": [
      "Client name",
      "Account no.",
      "Settlement Account",
      "Name/ Security",
      "Securities ID",
      "Currency",
      "Transaction Type",
      "Asset Type",
      "Trade Date",
      "Settlement Date",
      "Quantity",
      "Foreign Unit Price",
      "Foreign Gross Consideration",
      "Accrued Interest",
      "Foreign Net Consideration",
      "Net Consideration",
      "Exec Commission",
      "Research Commission",
      "Total Commission",
      "Transaction Fee",
      "Local Fee",
      "Local Tax",
      "Stamp Duty",
      "Foreign GST",
      "GST Equivalent",
      "GST ON (SR)"
    ],
    "parsing_rules": {
      "transaction_type": {
        "field": "Transaction Type",
        "priority": 1,
        "match_strategy": "keyword_only",
        "rules": [
          {
            "if_contains_any": [
              "WE HAVE SOLD FOR",
              "YOUR SALE"
            ],
            "set_value": "SELL"
          },
          {
            "if_contains_any": [
              "WE HAVE BOUGHT FOR",
              "YOUR PURCHASE"
            ],
            "set_value": "BUY"
          }
        ],
        "fallback": null,
        "constraints": {
          "do_not_infer_from_amount_sign": true
        }
      },
      "client_account": {
        "client_name": {
          "field": "Client name",
          "candidates": [
            {
              "source": "explicit_label",
              "labels_any_of": [
                "Client Name",
                "Client name",
                "For Account",
                "For Account :",
                "For Account  :"
              ],
              "value_type": "string",
              "postprocess": {
                "trim": true,
                "collapse_spaces": true
              }
            },
            {
              "source": "line_above_or_below_account_number_block",
              "description": "Tên quỹ thường nằm ngay dưới account number / portfolio number block",
              "value_type": "string",
              "postprocess": {
                "trim": true,
                "collapse_spaces": true
              }
            }
          ],
          "fallback": null
        },
        "account_no": {
          "field": "Account no.",
          "candidates": [
            {
              "source": "explicit_label",
              "labels_any_of": [
                "Account number",
                "Account number:",
                "Portfolio Number",
                "Portfolio number",
                "Portfolio Number:"
              ],
              "value_type": "string",
              "postprocess": {
                "trim": true
              }
            }
          ],
          "fallback": null
        },
        "settlement_account": {
          "field": "Settlement Account",
          "candidates": [
            {
              "source": "explicit_label",
              "labels_any_of": [
                "To the Credit of Account",
                "To the Debit of Account"
              ],
              "value_type": "string",
              "postprocess": {
                "trim": true
              }
            }
          ],
          "fallback": null
        }
      },
      "asset_type_detection": {
        "field": "Asset Type",
        "strategy": "text_based_only",
        "rules": [
          {
            "if_contains_any": [
              "Nominal",
              "Price in %",
              "MEDIUM TERM NOTES",
              "NOTE",
              "MTN",
              "TRANCHE",
              "GUARANTEED SERIES"
            ],
            "set_value": "BOND_NOTE_MTN"
          },
          {
            "if_contains_any": [
              "No. of Shares",
              "No. of Shares / Units",
              "shares",
              "Quantity",
              "Price per Share",
              "Price per Share / Unit"
            ],
            "set_value": "EQUITY_STOCK"
          }
        ],
        "fallback": null,
        "constraints": {
          "do_not_guess_if_ambiguous": true
        }
      },
      "security_info": {
        "name_security": {
          "field": "Name/ Security",
          "candidates": [
            {
              "when_asset_type_in": [
                "EQUITY_STOCK",
                null
              ],
              "source": "explicit_label",
              "labels_any_of": [
                "Security",
                "Name/ Security",
                "Name / Security",
                "of :"
              ],
              "value_type": "string",
              "postprocess": {
                "trim": true,
                "collapse_spaces": true
              }
            },
            {
              "when_asset_type_in": [
                "BOND_NOTE_MTN"
              ],
              "source": "explicit_label",
              "labels_any_of": [
                "Security",
                "Name/ Security",
                "Name / Security"
              ],
              "value_type": "string_multiline",
              "postprocess": {
                "trim": true,
                "collapse_spaces": true
              }
            }
          ],
          "fallback": null
        },
        "securities_id": {
          "field": "Securities ID",
          "priority_order": [
            "ISIN",
            "CUSIP",
            "SEDOL"
          ],
          "candidates": [
            {
              "source": "explicit_label",
              "labels_any_of": [
                "ISIN",
                "ISIN Code",
                "ISIN Code:",
                "ISIN :"
              ],
              "value_type": "string",
              "set_as": "ISIN"
            },
            {
              "source": "explicit_label",
              "labels_any_of": [
                "Cusip",
                "Cusip :",
                "Security No."
              ],
              "value_type": "string",
              "set_as": "CUSIP"
            },
            {
              "source": "explicit_label",
              "labels_any_of": [
                "Sedol",
                "SEDOL",
                "SEDOL Code"
              ],
              "value_type": "string",
              "set_as": "SEDOL"
            }
          ],
          "fallback": null
        },
        "quantity": {
          "field": "Quantity",
          "rules_by_asset_type": [
            {
              "when_asset_type": "EQUITY_STOCK",
              "candidates": [
                {
                  "source": "explicit_label",
                  "labels_any_of": [
                    "Quantity",
                    "No. of Shares",
                    "No. of Shares / Units"
                  ],
                  "value_type": "number",
                  "postprocess": {
                    "remove_commas": true
                  }
                }
              ]
            },
            {
              "when_asset_type": "BOND_NOTE_MTN",
              "candidates": [
                {
                  "source": "explicit_label",
                  "labels_any_of": [
                    "Nominal"
                  ],
                  "value_type": "number_with_currency",
                  "postprocess": {
                    "extract_number": true,
                    "remove_commas": true
                  }
                }
              ]
            }
          ],
          "fallback": null
        },
        "foreign_unit_price": {
          "field": "Foreign Unit Price",
          "rules_by_asset_type": [
            {
              "when_asset_type": "EQUITY_STOCK",
              "candidates": [
                {
                  "source": "explicit_label",
                  "labels_any_of": [
                    "Price",
                    "Price per Share",
                    "Price per Share / Unit"
                  ],
                  "value_type": "number",
                  "postprocess": {
                    "remove_commas": true
                  }
                }
              ]
            },
            {
              "when_asset_type": "BOND_NOTE_MTN",
              "candidates": [
                {
                  "source": "explicit_label",
                  "labels_any_of": [
                    "Price in %"
                  ],
                  "value_type": "number",
                  "postprocess": {
                    "remove_commas": true
                  }
                }
              ]
            }
          ],
          "fallback": null
        }
      },
      "dates": {
        "trade_date": {
          "field": "Trade Date",
          "candidates": [
            {
              "source": "explicit_label",
              "labels_any_of": [
                "Trade Date",
                "Traded on"
              ],
              "value_type": "date"
            }
          ],
          "fallback": null
        },
        "settlement_date": {
          "field": "Settlement Date",
          "candidates": [
            {
              "source": "explicit_label",
              "labels_any_of": [
                "Settlement Date",
                "Value Date"
              ],
              "value_type": "date"
            }
          ],
          "fallback": null
        },
        "constraints": {
          "do_not_swap_trade_and_settlement": true
        }
      },
      "currency": {
        "field": "Currency",
        "strategy": "read_from_price_or_consideration_line",
        "candidates": [
          {
            "source": "same_line_as_any_of",
            "labels_any_of": [
              "Price",
              "Price per Share",
              "Price per Share / Unit",
              "Consideration",
              "Gross Amount"
            ],
            "value_type": "currency_code_or_symbol",
            "allowed_examples": [
              "USD",
              "JPY",
              "GBP",
              "EUR"
            ]
          }
        ],
        "fallback": null,
        "constraints": {
          "no_conversion": true
        }
      },
      "amounts_consideration": {
        "equity_stock": {
          "foreign_gross_consideration": {
            "field": "Foreign Gross Consideration",
            "candidates": [
              {
                "source": "explicit_label",
                "labels_any_of": [
                  "Consideration",
                  "Gross Amount"
                ],
                "value_type": "money",
                "postprocess": {
                  "remove_commas": true
                }
              }
            ],
            "fallback": null
          },
          "exec_commission": {
            "field": "Exec Commission",
            "candidates": [
              {
                "source": "explicit_label",
                "labels_any_of": [
                  "Exec Commission",
                  "Commission"
                ],
                "value_type": "money",
                "postprocess": {
                  "remove_commas": true
                }
              }
            ],
            "fallback": null
          },
          "transaction_fee": {
            "field": "Transaction Fee",
            "candidates": [
              {
                "source": "explicit_label",
                "labels_any_of": [
                  "Transaction Fee",
                  "Third Party Fees"
                ],
                "value_type": "money",
                "postprocess": {
                  "remove_commas": true
                }
              }
            ],
            "fallback": null
          },
          "foreign_net_consideration": {
            "field": "Foreign Net Consideration",
            "candidates": [
              {
                "source": "explicit_label",
                "labels_any_of": [
                  "Net Figure",
                  "Total Amount",
                  "Net Consideration"
                ],
                "value_type": "money",
                "postprocess": {
                  "remove_commas": true
                }
              }
            ],
            "fallback": null,
            "formula_check": {
              "enabled": true,
              "formula": "net = gross - exec_commission - transaction_fee",
              "tolerance": 0.01,
              "if_mismatch": "prefer_explicit_net_value"
            }
          }
        },
        "bond_note_mtn": {
          "foreign_gross_consideration": {
            "field": "Foreign Gross Consideration",
            "candidates": [
              {
                "source": "explicit_label",
                "labels_any_of": [
                  "Gross Amount"
                ],
                "value_type": "money",
                "postprocess": {
                  "remove_commas": true
                }
              }
            ],
            "fallback": null
          },
          "accrued_interest": {
            "field": "Accrued Interest",
            "candidates": [
              {
                "source": "explicit_label",
                "labels_any_of": [
                  "Accrued Interest"
                ],
                "value_type": "money",
                "postprocess": {
                  "remove_commas": true
                }
              }
            ],
            "fallback": null
          },
          "foreign_net_consideration": {
            "field": "Foreign Net Consideration",
            "candidates": [
              {
                "source": "explicit_label",
                "labels_any_of": [
                  "Total Amount",
                  "Net Figure"
                ],
                "value_type": "money",
                "postprocess": {
                  "remove_commas": true
                }
              }
            ],
            "fallback": null,
            "formula_check": {
              "enabled": true,
              "formula": "net = gross + accrued_interest",
              "tolerance": 0.01,
              "if_mismatch": "prefer_explicit_net_value"
            },
            "constraints": {
              "accrued_interest_is_not_commission": true
            }
          }
        }
      },
      "tax_and_gst": {
        "foreign_gst": {
          "field": "Foreign GST",
          "extract_only_if_present": true,
          "labels_any_of": [
            "GST",
            "VAT"
          ],
          "value_type": "money",
          "fallback": null
        },
        "gst_equivalent": {
          "field": "GST Equivalent",
          "extract_only_if_present": true,
          "labels_any_of": [
            "GST Equivalent"
          ],
          "value_type": "money",
          "fallback": null
        },
        "gst_on_sr": {
          "field": "GST ON (SR)",
          "extract_only_if_present": true,
          "labels_any_of": [
            "GST ON (SR)"
          ],
          "value_type": "money",
          "fallback": null
        },
        "constraints": {
          "do_not_infer_gst_from_commission": true
        }
      },
      "fees_local": {
        "local_fee": {
          "field": "Local Fee",
          "extract_only_if_present": true,
          "labels_any_of": [
            "Local Fee"
          ],
          "value_type": "money",
          "fallback": null
        },
        "local_tax": {
          "field": "Local Tax",
          "extract_only_if_present": true,
          "labels_any_of": [
            "Local Tax"
          ],
          "value_type": "money",
          "fallback": null
        },
        "stamp_duty": {
          "field": "Stamp Duty",
          "extract_only_if_present": true,
          "labels_any_of": [
            "Stamp Duty"
          ],
          "value_type": "money",
          "fallback": null
        }
      },
      "commissions": {
        "research_commission": {
          "field": "Research Commission",
          "extract_only_if_present": true,
          "labels_any_of": [
            "Research Commission"
          ],
          "value_type": "money",
          "fallback": null
        },
        "total_commission": {
          "field": "Total Commission",
          "extract_only_if_present": true,
          "labels_any_of": [
            "Total Commission",
            "Total Commissions"
          ],
          "value_type": "money",
          "fallback": null
        }
      },
      "final_value": {
        "net_consideration": {
          "field": "Net Consideration",
          "source_priority": [
            "Net Figure",
            "Total Amount"
          ],
          "constraints": {
            "must_equal_explicit_final_amount": true,
            "tolerance": 0.0
          },
          "fallback": null
        }
      }
    },
    "validation": {
      "required_fields_minimum": [
        "Transaction Type",
        "Client name",
        "Account no.",
        "Name/ Security",
        "Securities ID",
        "Currency",
        "Trade Date",
        "Settlement Date"
      ],
      "consistency_checks": [
        {
          "name": "net_equals_explicit",
          "description": "Net Consideration phải khớp tuyệt đối với Net Figure hoặc Total Amount nếu có.",
          "enabled": true
        },
        {
          "name": "no_trade_settlement_swap",
          "description": "Không được hoán đổi Trade Date và Settlement Date.",
          "enabled": true
        }
      ],
      "on_validation_fail": {
        "action": "return_null_for_failed_fields",
        "emit_warnings": true
      }
    }
  }
}